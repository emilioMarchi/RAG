{
  "name": "rag-studio",
  "version": "1.0.0",
  "description": "RAG Studio — Hierarchical Contextual RAG Desktop App",
  "type": "module",
  "main": "electron/main.js",
  "build": {
    "appId": "com.emi.ragstudio",
    "productName": "RAG Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "public/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json",
      ".env"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico"
    }
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "migrate": "tsx src/migrate.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "console": "tsx src/console.ts",
    "electron": "npm run build && electron electron/main.js",
    "electron:dev": "cross-env ELECTRON_DEV=1 electron electron/main.js",
    "package": "npm run build && electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1095.0",
    "@aws-sdk/s3-request-presigner": "^3.1095.0",
    "@google/genai": "^2.13.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "openai": "^6.49.0",
    "pdf-parse": "^2.4.5",
    "pdf-to-img": "^6.2.0",
    "pg": "^8.22.0",
    "tesseract.js": "^7.0.0",
    "vis-network": "^10.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
