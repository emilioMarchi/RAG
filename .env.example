# ============================================
#  RAG Studio - Configuracion
#  Copia este archivo como ".env" y completa tus credenciales.
# ============================================

# Gemini (UNICAMENTE EMBEDDINGS, solo si EMBEDDING_PROVIDER=gemini) - OPCIONAL
# Con EMBEDDING_PROVIDER=local NO se usa Gemini y esta key no es necesaria.
GEMINI_API_KEY=

# LLM API (OpenAI-compatible, ej: OpenRouter) - OBLIGATORIO
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Modelo de respaldo: se usa solo si el principal devuelve 429 (rate limit).
LLM_BACKUP_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Database (PostgreSQL + pgvector) - usa docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_db

# ============================================
#  Almacenamiento de archivos
#  - 'local' (default): guarda los archivos en disco (LOCAL_STORAGE_DIR).
#    Ideal para usar la app en cualquier PC sin depender de la nube.
#  - 'r2': sube a Cloudflare R2. Solo si completas las credenciales R2 abajo.
# ============================================
STORAGE_MODE=local
LOCAL_STORAGE_DIR=data/documents

# Cloudflare R2 (OPCIONAL - solo si STORAGE_MODE=r2)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Server
PORT=3000

# ============================================
#  Ingesta de documentos
#  Ajustar si el LLM tiene rate limits bajos (ej: modelos free en OpenRouter).
# ============================================
# Cuántos chunks procesar en paralelo durante la ingesta.
# Con modelos free: usar 1 o 2. Con modelos de pago: se puede subir a 5+.
INGESTION_CONCURRENCY=2
# Graph RAG (entidades/relaciones con el LLM): desactivado por defecto porque el
# grafo aún no tiene consumidores. Acelera la ingesta. Reactivar cuando exista
# un endpoint/vista que lo lea (p. ej. /api/query/relations real basado en tablas).
INGESTION_ENABLE_GRAPH_RAG=false
# Enriquecimiento determinista: construye el contexto sin llamar al LLM (más
# rápido y sin costo por fragmento). Poner en false para volver a llm.enrichChunk.
INGESTION_DETERMINISTIC_ENRICH=true

# ============================================
#  Modelos LOCALES (transformers.js / ONNX)
#  Embeddings y re-ranking corren en CPU sin llamadas de red después de la
#  primera descarga del modelo (~40MB embedding + ~120MB reranker).
#  La descarga ocurre en la primera ejecución al cache de Hugging Face
#  (~/.cache/huggingface/hub) y se puede pre-cargar offline después.
# ============================================
# Proveedor de embeddings: 'local' (ONNX CPU, default recomendado) | 'gemini' (API).
EMBEDDING_PROVIDER=local
# Modelo local de embeddings (384d, multilingüe incluye español).
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# Dimensión del modelo local. Debe coincidir con la columna vector() de la DB.
EMBEDDING_DIMENSIONS=384
# Cross-encoder local para RAG_RERANK_STRATEGY=local (multilingüe, incluye español).
RERANKER_MODEL=SugoLabs/mmarco-mMiniLMv2-L12-H384-v1

# ============================================
#  Motor RAG (latencia de consulta)
#  Estos knobs reducen el nº de llamadas LLM y embeddings por consulta.
#  Valores conservadores = menor latencia. Sube precisión a cambio de tiempo.
# ============================================
# Máxima cantidad de iteraciones del bucle de expansión de contexto (default 4).
RAG_MAX_ITERATIONS=4
# Estrategia de re-ranking: 'hybrid' (determinista, SIN LLM, default) | 'llm' |
# 'local' (cross-encoder ONNX en CPU, sin red ni API).
RAG_RERANK_STRATEGY=local
# Corrective RAG: nº máximo de pases de re-búsqueda (0 = desactivado, default 0).
# Cada pase añade 1 embed + 1 búsqueda + 1 llamada LLM (evaluación). Deja en 0
# para el menor tiempo de respuesta y menos exposición a rate-limit.
RAG_CRAG_MAX_PASSES=0
# Bucle de expansión de contexto con LLM (evaluateContext). false (default) evita
# una llamada LLM cara que puede colgarse con modelos free. true añade precisión.
RAG_ENABLE_CONTEXT_EXPANSION=false
# Descomposición de query con LLM. El guard heurístico ya evita el LLM en queries
# simples; poner en false fuerza a nunca descomponer (solo acelera en queries
# multi-intención reales).
RAG_ENABLE_DECOMPOSE=true
# Presupuesto global de latencia por consulta (ms). 0 = sin límite (default).
# IMPORTANTE: 0 recomendado. Un valor bajo NO cancela el pipeline: las llamadas
# LLM/embedding ya iniciadas siguen corriendo y el timeout lanza QueryTimeoutError,
# lo que ABORTA la respuesta RAG completa (incluso la versión parcial válida).
RAG_TIMEOUT_MS=0
# Espera por reintento ante rate-limit (429) del LLM (ms). Bajo = responde más
# rápido pero reintenta menos. Alto = aguanta más pero puede colgar la consulta.
RAG_RATE_LIMIT_RETRY_MS=10000