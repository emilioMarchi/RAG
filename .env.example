# Gemini (ÚNICAMENTE EMBEDDINGS)
GEMINI_API_KEY=tus_gemini_key

# LLM API (OpenAI-compatible, ej: OpenRouter)
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=tus_openrouter_key
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_db

# Cloudflare R2 Storage (opcional en local)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=
S3_API_ENDPOINT=

# Server
PORT=3000