# ============================================
#  RAG Studio - Configuracion
#  Copia este archivo como ".env" y completa tus credenciales.
# ============================================

# Gemini (UNICAMENTE EMBEDDINGS) - OBLIGATORIO
GEMINI_API_KEY=

# LLM API (OpenAI-compatible, ej: OpenRouter) - OBLIGATORIO
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free

# Database (PostgreSQL + pgvector) - usa docker-compose.yml
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rag_db

# ============================================
#  Almacenamiento de archivos
#  - 'local' (default): guarda los archivos en disco (LOCAL_STORAGE_DIR).
#    Ideal para usar la app en cualquier PC sin depender de la nube.
#  - 'r2': sube a Cloudflare R2. Solo si completas las credenciales R2 abajo.
# ============================================
STORAGE_MODE=local
LOCAL_STORAGE_DIR=data/documents

# Cloudflare R2 (OPCIONAL - solo si STORAGE_MODE=r2)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_DOMAIN=

# Server
PORT=3000